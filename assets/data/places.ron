// The map of the menus: the places in the bar, in order, the tabs of each,
// and every control planned for each. Rename or rearrange here; no menu code
// holds a name of its own.
// `job` is the one line saying what is decided there. `content` names what
// a tab, or a place without tabs, shows once its system is built; one
// without it says so.
//
// A control is (name, does, and then whichever of these apply):
//   does      what it does, or will do, in one plain sentence.
//   issue     the issue that will make it work. A control with an issue and
//             no action or shows is not built: it is drawn as unavailable, and a
//             press says so and says what it will do.
//   proposed  the issue is a proposal the owner has not decided.
//   action    what it does today: Element(Fire), Equip, SetOut, Undo,
//             Earlier, Later.
//   shows     what a press opens in the side panel of its page: Keys.
//   key       the key that works it, printed on it: a letter, a digit, a
//             square bracket or Space. Only a control with an action or a
//             shows has one.
// Every key is in this file (#229). A place's `key` opens it and a control's
// presses it, wherever the player is. A tab's `key` chooses it while its
// place is showing, so two places may use the same keys for their tabs and
// no tab may use a key of the first kind. `horse_keys` select the horses of
// the party, in order. `scroll_keys` move what a side panel says, or the
// page when no panel is open, up and down where it does not fit (#304).
// `marks` says what puts a mark on a place (#232).
// `cargo` is the controls of the cargo column, `footer` the footer's.
// `card` is what can be done with a piece of gear (#228). Those controls are
// on the piece's card, in the side panel of whichever place it is opened in,
// so no place owns a verb.
// Guidance: docs/philosophy/menus.md. How it works: docs/menu-shell.md.
#![enable(implicit_some)]
(
    places: [
        (
            name: "Horses",
            key: "H",
            // The horses down the left and the shared cargo down the right
            // stay in view on every tab.
            horse_columns: true,
            tabs: [
                (
                    name: "Gear",
                    key: "1",
                    job: "What every horse wears, beside what is carried.",
                    content: Gear,
                    controls: [
                        (name: "Take off", does: "Takes the piece in the open slot off the selected horse and puts it in the cargo.", issue: 227),
                        (name: "Compare", does: "Shows a piece beside the one it would replace, with the difference in each stat.", issue: 11),
                        (name: "Undo", does: "Takes back the last change made during this town visit: gear and the element, one step a press. Setting out ends the visit, and nothing before it can be taken back.", action: Undo, key: "U"),
                        (name: "Save loadout", does: "Saves the party's gear and abilities under a name.", issue: 50),
                        (name: "Restore loadout", does: "Puts a saved loadout back on the party in one action.", issue: 50),
                        (name: "Sets", does: "Shows the party sets these pieces belong to, and how many pieces of each are worn.", issue: 36),
                    ],
                ),
                (
                    name: "Abilities",
                    key: "2",
                    job: "Which abilities the selected horse carries.",
                    content: Element,
                    controls: [
                        (name: "Fire", does: "The party fights with Fire on the next trail.", action: Element(Fire), key: "F"),
                        (name: "Ice", does: "The party fights with Ice on the next trail.", action: Element(Ice), key: "I"),
                        (name: "Plant", does: "The party fights with Plant on the next trail.", action: Element(Plant), key: "P"),
                        (name: "Equip ability", does: "Puts an ability the selected horse has bought into one of its slots.", issue: 222),
                        (name: "Spend points", does: "Buys an ability from the shared pool with the selected horse's ability points.", issue: 220),
                        (name: "Reassign points", does: "Takes the selected horse's ability points back, to spend again.", issue: 220),
                        (name: "Policy", does: "Chooses when an ability fires, from a short list of rules.", issue: 22),
                        (name: "Variant", does: "Chooses which variant of an ability is active.", issue: 23),
                        (name: "Focus", does: "Chooses what the party attacks first.", issue: 24),
                        (name: "Stance", does: "Chooses aggressive, balanced or defensive for the party.", issue: 24),
                        (name: "Recovery", does: "Chooses when the party's healing is spent.", issue: 25),
                        (name: "Party profile", does: "Says what this build is good and bad at.", issue: 49),
                    ],
                ),
                (
                    name: "Pet",
                    key: "3",
                    job: "Which pet rides with the selected horse.",
                    controls: [
                        (name: "Assign pet", does: "Seats a pet from the collection on the selected horse's saddle.", issue: 106),
                        (name: "Send pet home", does: "Takes the pet off the selected horse and back into the collection.", issue: 106),
                        (name: "Change collar", does: "Puts a collar on the pet, which changes how it helps.", issue: 139),
                    ],
                ),
                (
                    name: "Look",
                    key: "4",
                    job: "How the selected horse looks.",
                    controls: [
                        (name: "Wardrobe", does: "Browses the looks, with a preview on the horse beside its current look.", issue: 132, proposed: true),
                        (name: "Wear look", does: "Shows a piece with a look from the library and leaves its stats alone.", issue: 92),
                        (name: "Follow gear", does: "Puts a slot back to showing the piece that is equipped.", issue: 129),
                        (name: "Recolour", does: "Chooses a palette for a piece, with a preview.", issue: 67),
                        (name: "Coat and mane", does: "Chooses the horse's coat, mane and tail; locks and rerolls its traits.", issue: 68),
                        (name: "Save outfit", does: "Saves the horse's looks and palettes under a name.", issue: 133),
                        (name: "Restore outfit", does: "Puts a saved outfit back on the horse without touching its gear.", issue: 133),
                        (name: "Party theme", does: "Applies one palette or emblem across the whole party.", issue: 134, proposed: true),
                    ],
                ),
            ],
            cargo: [
                (name: "Filter", does: "Shows only some of the cargo: by slot, rarity, new, favourite or usable by the selected horse.", issue: 235),
                (name: "Sort", does: "Puts the cargo in another order.", issue: 235),
                (name: "Search", does: "Finds a piece by its name.", issue: 235),
            ],
        ),
        // Every piece the party has, by type (#308): a place of its own
        // (the owner, 2026-10-11). Its tiles are its controls: the pointer
        // on one compares it, and a press pins its card.
        (
            name: "Inventory",
            key: "B",
            job: "Every piece the party has, worn or carried, by type. Point at one to compare it; press it to equip it.",
            content: Inventory,
        ),
        (
            name: "Trade",
            key: "T",
            tabs: [
                (
                    name: "Sell",
                    key: "1",
                    job: "What is listed at the stall, and at what price.",
                    controls: [
                        (name: "List selected", does: "Makes the selected pieces the stall's stock, after showing their count and what they could earn.", issue: 99),
                        (name: "Take back", does: "Takes a listed piece off the stall and back into the cargo.", issue: 99),
                        (name: "Set price", does: "Prices a piece, a category or all new stock: fair, friendly, premium or custom.", issue: 101),
                        (name: "Buy back", does: "Buys a piece sold this visit back at the price paid.", issue: 151),
                        (name: "List goods", does: "Lists trade goods from the hold at the stall.", issue: 209),
                    ],
                ),
                (
                    name: "Buy",
                    key: "2",
                    job: "Gear and goods this town sells.",
                    controls: [
                        (name: "Buy piece", does: "Buys a piece of gear from the town's shop with coins.", issue: 141, proposed: true),
                        (name: "Use service", does: "Pays for a service this town offers.", issue: 141, proposed: true),
                        (name: "Buy goods", does: "Buys trade goods at this town's price, into the hold.", issue: 209),
                    ],
                ),
                (
                    name: "Storage",
                    key: "3",
                    job: "What is kept in this town's stash.",
                    controls: [
                        (name: "Store", does: "Moves a piece from the cargo into this town's stash.", issue: 202),
                        (name: "Take out", does: "Moves a piece from this town's stash into the cargo.", issue: 202),
                    ],
                ),
                (
                    name: "Rules",
                    key: "4",
                    job: "Keep rules and auto-buy rules.",
                    controls: [
                        (name: "Add keep rule", does: "Adds a rule saying what the party keeps, ignores or protects.", issue: 52),
                        (name: "Reorder rules", does: "Changes which keep rule is tried first.", issue: 52),
                        (name: "Test rules", does: "Tries the keep rules on the cargo without dropping anything, and shows the counts.", issue: 167),
                        (name: "Add buy rule", does: "Adds a rule to buy or list a good at a stop when its price is right.", issue: 211),
                        (name: "Save route", does: "Saves a list of stops and their rules as a route to repeat.", issue: 211),
                    ],
                ),
            ],
        ),
        (
            name: "Map",
            key: "M",
            job: "Destination, route options, the itinerary, and what is restored.",
            controls: [
                (name: "Choose destination", does: "Picks a city, and shows the route to it before the party leaves.", issue: 156),
                (name: "Route", does: "Chooses between the safest, the fastest and a balanced route.", issue: 157, proposed: true),
                (name: "Add to itinerary", does: "Queues a destination for the party to leave for by itself.", issue: 201),
                (name: "Clear itinerary", does: "Empties the queue, so the party waits in town.", issue: 201),
                (name: "Trail modifiers", does: "Shows what the trail ahead has rolled, and what answers it.", issue: 28),
                (name: "World map", does: "Shows the regions, towns and routes, what is restored, and where each horse lives.", issue: 123),
            ],
        ),
        (
            name: "Town",
            key: "N",
            tabs: [
                (
                    name: "Projects",
                    key: "1",
                    job: "Deliveries to this town's projects.",
                    controls: [
                        (name: "Deliver", does: "Hands over goods and coins from the hold to a town project.", issue: 172),
                    ],
                ),
                (
                    name: "Residents",
                    key: "2",
                    job: "Recruits, retired horses, invitations back, and retiring.",
                    controls: [
                        (name: "Choose party", does: "Decides who travels and who stays in this town.", issue: 102),
                        (name: "Retire here", does: "Retires a party horse into this town; its gear and its pet come back to the party.", issue: 117),
                        (name: "Invite back", does: "Asks a horse retired in this town to rejoin the party.", issue: 117),
                        (name: "Meet", does: "Opens a horse who lives in this town: its name, look, trait and record.", issue: 116, proposed: true),
                    ],
                ),
            ],
        ),
        (
            name: "Journal",
            key: "J",
            tabs: [
                (
                    name: "Report",
                    key: "1",
                    job: "The latest loot, trail and stall reports, and the earlier ones behind them.",
                    content: Report,
                    controls: [
                        (name: "Loot report", does: "Shows the latest loot: the ordinary in one line, the best one piece at a time.", issue: 32),
                        (name: "Trail report", does: "Shows what happened on the last trail and why.", issue: 51),
                        (name: "Stall report", does: "Shows what sold while the party was away.", issue: 170),
                        (name: "Earlier", does: "Opens the report before the one showing. Reports are kept as the party moves on.", action: Earlier, key: "["),
                        (name: "Later", does: "Opens the report after the one showing, as far as the latest.", action: Later, key: "]"),
                    ],
                ),
                (
                    name: "Journal",
                    key: "2",
                    job: "What happened on the road.",
                    controls: [
                        (name: "One horse", does: "Shows only the selected horse's part of the journal.", issue: 107),
                    ],
                ),
                (
                    name: "Codex",
                    key: "3",
                    job: "What has been found.",
                    controls: [
                        (name: "Gear effects", does: "Lists the gear effects found, and the unfound ones in outline.", issue: 30),
                        (name: "Sets", does: "Lists the sets found, and the unfound ones in outline.", issue: 30),
                        (name: "Final enemies", does: "Lists the pieces only a final enemy drops.", issue: 30),
                    ],
                ),
            ],
        ),
    ],
    // At the far end of the bar. Not one of the places.
    settings: (
        name: "Settings",
        key: "S",
        job: "How the game feels and how it is worked.",
        controls: [
            (name: "Shake", does: "Turns screen shake down, from full to off.", issue: 45),
            (name: "Flash", does: "Turns flashes down, from full to off.", issue: 45),
            (name: "Effects", does: "Turns the number of effects down, from full to off.", issue: 45),
            (name: "Volume", does: "Turns the sound down, from full to off.", issue: 45),
            (name: "Keys", does: "Shows the key for every place, tab and action.", shows: Keys, key: "K"),
        ],
    ),
    horse_keys: ["Z", "X", "C"],
    scroll_keys: ("PageUp", "PageDown"),
    // What puts a mark on a place, and on the tab of it the thing is on
    // (#232): something there not yet seen. It goes when the thing has been
    // in view and does not come back for the same thing. Nothing routine is
    // here: a sale, a common drop and a trail that was simply won raise none.
    //   Upgrade  the piece in the cargo betters what some horse wears. The
    //            cargo is beside every tab, so no tab is named.
    //   Report   the newest report kept: `lost`, its trail was lost;
    //            `rarity`, it dropped a piece of at least that rarity.
    marks: [
        (raise: Upgrade, place: "Horses"),
        (raise: Report(lost: true, rarity: "Legendary"), place: "Journal", tab: "Report"),
    ],
    footer: [
        (name: "Planned changes", does: "Lists the changes planned on the road, to edit or cancel before the party arrives.", issue: 234),
        (name: "Set out", does: "Sends the party off on the next trail.", action: SetOut, key: "Space"),
    ],
    card: [
        (name: "Equip", does: "Puts the piece on the selected horse. A piece another horse wears changes places with what the selected horse wears in that slot. With no card open, it is the piece in the cargo.", action: Equip, key: "E"),
        (name: "List", does: "Lists the piece at the stall.", issue: 99),
        (name: "Store", does: "Puts the piece in this town's stash.", issue: 202),
        (name: "Lock", does: "Keeps the piece safe from every automatic action.", issue: 34),
        (name: "Favourite", does: "Marks the piece as a favourite.", issue: 228),
        (name: "Look", does: "Shows the piece's look on the selected horse and leaves its stats alone.", issue: 92),
    ],
)
