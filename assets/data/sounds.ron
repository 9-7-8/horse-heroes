// The game's sounds. There are no sound files: each sound is made when the
// game starts, from the recipe here, so every one is ours to give away under
// the GPL and nothing is read from disk. Which sound plays when is not here:
// a rarity names its drop sound in gear.ron, a fountain its launch sound in
// loot_shower.ron, a death its own in deaths.ron, an ability its own in
// abilities.ron, and the landing, pickup and hit sounds are named in `sound`
// in loot_shower.ron.
//
// A sound is a list of voices, added together. A voice is one tone:
//   wave     Sine, Triangle, Square, or Noise (a hiss; `freq` is how bright)
//   freq     its pitch at the start, in hertz
//   slide    how far the pitch moves by the end, in semitones (12 an octave)
//   at       seconds into the sound at which it starts
//   secs     how long it lasts; it dies away over that time
//   attack   seconds it takes to come up; short is a click, long is a swell
//   level    how loud, 0 to 1. The levels sounding together must not pass 1.
// Change one voice at a time and listen (procedures/tune-loot-feel.txt).
(
    sounds: {
        // A burst leaving a body. An ordinary kill: a small pop.
        "launch_small": [
            (wave: Sine,  freq: 220,  slide: 12, secs: 0.09, level: 0.3),
            (wave: Noise, freq: 1800,            secs: 0.05, level: 0.12),
        ],
        // A trail's last enemy: a rush of air going up, over a rising note.
        "launch_full": [
            (wave: Noise, freq: 400, slide: 36, secs: 0.45, attack: 0.08, level: 0.45),
            (wave: Sine,  freq: 110, slide: 19, secs: 0.4,  attack: 0.02, level: 0.35),
        ],

        // An enemy's body breaking, named by its death in deaths.ron. It
        // sounds with the launch, so it is kept short, or lower than it.
        // An ordinary enemy: a short dry crack.
        "death_small": [
            (wave: Noise,  freq: 3200,             secs: 0.06, attack: 0.001, level: 0.26),
            (wave: Square, freq: 480,  slide: -14, secs: 0.05, attack: 0.001, level: 0.1),
        ],
        // A trail's last enemy: the crack, and a boom falling away under it.
        "death_big": [
            (wave: Noise, freq: 2400,             secs: 0.1,  attack: 0.001, level: 0.2),
            (wave: Sine,  freq: 82,   slide: -12, secs: 0.6,  attack: 0.004, level: 0.34),
            (wave: Noise, freq: 220,  slide: -12, secs: 0.5,  attack: 0.01,  level: 0.16),
        ],

        // A piece touching the ground. A coin clinks; gear thuds.
        "land_coin": [
            (wave: Sine, freq: 2100, secs: 0.07, attack: 0.001, level: 0.28),
            (wave: Sine, freq: 3150, secs: 0.05, attack: 0.001, level: 0.14),
        ],
        "land_gear": [
            (wave: Sine,  freq: 150, slide: -7, secs: 0.12, attack: 0.002, level: 0.5),
            (wave: Noise, freq: 900,            secs: 0.05, attack: 0.001, level: 0.18),
        ],

        // A piece reaching the party. The coin's tick is the one whose pitch
        // climbs across a stream of pickups.
        "pickup_coin": [
            (wave: Triangle, freq: 520,  secs: 0.09, level: 0.34),
            (wave: Sine,     freq: 1040, secs: 0.06, level: 0.14),
        ],
        "pickup_gear": [
            (wave: Sine, freq: 392, secs: 0.22, level: 0.34),
            (wave: Sine, freq: 784, secs: 0.18, level: 0.18),
        ],

        // An ability being used, named by the ability in abilities.ron
        // (#358). Each is told by its shape as much as its pitch.
        // Ember Shot: a flare of air rushing up, over a rising note.
        "ability_ember_shot": [
            (wave: Noise, freq: 1500, slide: 24, secs: 0.2,  attack: 0.03, level: 0.3),
            (wave: Sine,  freq: 330,  slide: 12, secs: 0.18, attack: 0.02, level: 0.24),
        ],
        // Frost Burst: a shimmer of high glassy notes falling, one after the
        // other.
        "ability_frost_burst": [
            (wave: Sine, freq: 2637, at: 0.0,  secs: 0.25, attack: 0.002, level: 0.16),
            (wave: Sine, freq: 2093, at: 0.05, secs: 0.25, attack: 0.002, level: 0.16),
            (wave: Sine, freq: 1760, at: 0.1,  secs: 0.3,  attack: 0.002, level: 0.16),
            (wave: Noise, freq: 6000,          secs: 0.3,  attack: 0.05,  level: 0.08),
        ],
        // Thorn Shot: a low twang, plucked and bending down.
        "ability_thorn_shot": [
            (wave: Triangle, freq: 196, slide: -3, secs: 0.22, attack: 0.001, level: 0.4),
            (wave: Square,   freq: 98,  slide: -3, secs: 0.08, attack: 0.001, level: 0.08),
        ],
        // Ward: a soft swell of an open fifth.
        "ability_ward": [
            (wave: Sine, freq: 262, secs: 0.55, attack: 0.15, level: 0.24),
            (wave: Sine, freq: 392, secs: 0.55, attack: 0.15, level: 0.2),
            (wave: Sine, freq: 524, secs: 0.45, attack: 0.2,  level: 0.08),
        ],

        // A horse's hit on an enemy, by the hit's element, named in `sound`
        // in loot_shower.ron (#358). Short, as they come often.
        // No element: a dull thump.
        "hit_plain": [
            (wave: Sine,  freq: 140, slide: -5, secs: 0.07, attack: 0.001, level: 0.36),
            (wave: Noise, freq: 1200,           secs: 0.03, attack: 0.001, level: 0.14),
        ],
        // Fire: a crackle.
        "hit_fire": [
            (wave: Noise,  freq: 4500,             secs: 0.1,  attack: 0.001, level: 0.24),
            (wave: Square, freq: 220,  slide: -12, secs: 0.06, attack: 0.001, level: 0.08),
        ],
        // Ice: a tink.
        "hit_ice": [
            (wave: Sine, freq: 1760, secs: 0.12, attack: 0.001, level: 0.24),
            (wave: Sine, freq: 2640, secs: 0.08, attack: 0.001, level: 0.12),
        ],
        // Plant: a woody knock.
        "hit_plant": [
            (wave: Triangle, freq: 330, slide: -7, secs: 0.09, attack: 0.001, level: 0.32),
            (wave: Noise,    freq: 700,            secs: 0.05, attack: 0.001, level: 0.12),
        ],

        // A piece of gear being thrown, one for each rarity: more notes,
        // higher, longer and fuller with every tier.
        // Normal: one dull note.
        "drop_normal": [
            (wave: Triangle, freq: 330, secs: 0.18, level: 0.3),
        ],
        // Magic: two notes going up.
        "drop_magic": [
            (wave: Sine, freq: 523, at: 0.0,  secs: 0.22, level: 0.34),
            (wave: Sine, freq: 784, at: 0.07, secs: 0.26, level: 0.34),
        ],
        // Rare: three bright notes up an octave, each with a glint above it.
        "drop_rare": [
            (wave: Sine, freq: 659,  at: 0.0,  secs: 0.3,  level: 0.26),
            (wave: Sine, freq: 988,  at: 0.07, secs: 0.3,  level: 0.26),
            (wave: Sine, freq: 1319, at: 0.14, secs: 0.42, level: 0.26),
            (wave: Sine, freq: 2637, at: 0.14, secs: 0.3,  level: 0.1),
        ],
        // Legendary: a low boom, and a major chord climbing out of it.
        "drop_legendary": [
            (wave: Sine,     freq: 98,  slide: -5, at: 0.0,  secs: 0.7, attack: 0.01, level: 0.34),
            (wave: Triangle, freq: 392,            at: 0.0,  secs: 0.9, level: 0.15),
            (wave: Triangle, freq: 494,            at: 0.06, secs: 0.9, level: 0.15),
            (wave: Triangle, freq: 587,            at: 0.12, secs: 0.9, level: 0.15),
            (wave: Sine,     freq: 784,            at: 0.18, secs: 1.0, level: 0.15),
        ],
        // Set: a bell of stacked fifths struck at once, and a high ring after.
        "drop_set": [
            (wave: Sine, freq: 294,  at: 0.0,  secs: 1.2, attack: 0.002, level: 0.2),
            (wave: Sine, freq: 440,  at: 0.0,  secs: 1.2, attack: 0.002, level: 0.2),
            (wave: Sine, freq: 659,  at: 0.0,  secs: 1.1, attack: 0.002, level: 0.18),
            (wave: Sine, freq: 988,  at: 0.0,  secs: 1.0, attack: 0.002, level: 0.14),
            (wave: Sine, freq: 1976, at: 0.22, secs: 1.0, attack: 0.05,  level: 0.1),
        ],
    },
)
