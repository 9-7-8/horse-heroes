// Horse gear. A drop spends `points` stat points at random; a point spent on
// health is worth `health_per_point`. `win_weight` replaces `weight` when the
// final enemy was defeated.
// Rarities are listed lowest first, and a new one is one more line here.
// `look` is how its drops are told apart in the loot shower: a colour, how
// strongly the piece glows in it, its size, its shape (below), and for the
// tiers that have one a
// beam of light over it (lengths in world units, `alpha` 0 clear to 1 solid,
// `rise_secs` the time it takes to rise once the piece is thrown), and the
// screen's `response` when a burst erupts with this tier the best in it
// (`shake` in world units, `flash` 0 none to 1 opaque; both are scaled, and
// can be turned off, in loot_shower.ron; a flash is mixed as light, so a
// small number shows a good deal), and the `sound` a piece of this tier makes
// as it is thrown, by its name in sounds.ron. The tiers
// and their colours are the owner's (2026-10-10): white, blue, yellow, orange
// and green. They need not differ from the element colours, because rarity
// shows on drops and in menus only.
// `shape` is what tells a tier apart with no colour at all: the solids the
// piece is built of, as it lies flat, in world units before `size`. Each is
//   Box(long, thick, deep)        Ball(radius)
//   Ring(radius, tube radius)     Prism(sides, radius, thick)
// with `at: (along, up, across)` from the piece's middle and `turn` in degrees
// about the upright axis, both 0 if left out. A plain slab, a cross, a ringed
// stone, a sun with rays, and three stones for the herd.
// No bridles, bits or reins: nobody rides these horses. The Saddle slot seats
// a pet.
(
    health_per_point: 5,
    rarities: [
        (name: "Normal",    prefix: "Trail-worn",  weight: 60, win_weight: 35, points: (2, 3),
         look: (colour: "ffffff", glow: 0.0, size: 1.0,
                shape: [(solid: Box(0.46, 0.2, 0.34))],
                response: (shake: 0.03, flash: 0.0),
                sound: "drop_normal")),
        (name: "Magic",     prefix: "Fae-touched", weight: 27, win_weight: 35, points: (4, 5),
         look: (colour: "6969ff", glow: 0.4, size: 1.1,
                shape: [(solid: Box(0.54, 0.18, 0.17)),
                        (solid: Box(0.54, 0.18, 0.17), turn: 90)],
                response: (shake: 0.06, flash: 0.015),
                sound: "drop_magic")),
        (name: "Rare",      prefix: "Starlit",     weight: 9,  win_weight: 18, points: (7, 8),
         look: (colour: "ffff00", glow: 0.7, size: 1.2,
                shape: [(solid: Ring(0.21, 0.06)),
                        (solid: Ball(0.1))],
                response: (shake: 0.14, flash: 0.03),
                sound: "drop_rare")),
        (name: "Legendary", prefix: "Sunforged",   weight: 3,  win_weight: 8,  points: (10, 11),
         look: (colour: "ff8000", glow: 1.5, size: 1.35,
                shape: [(solid: Prism(8, 0.19, 0.2)),
                        (solid: Box(0.68, 0.12, 0.1)),
                        (solid: Box(0.68, 0.12, 0.1), turn: 45),
                        (solid: Box(0.68, 0.12, 0.1), turn: 90),
                        (solid: Box(0.68, 0.12, 0.1), turn: 135)],
                beam: Some((height: 7.0, width: 0.16, alpha: 0.45, rise_secs: 0.15)),
                response: (shake: 0.26, flash: 0.06),
                sound: "drop_legendary")),
        (name: "Set",       prefix: "Herd-sworn",  weight: 1,  win_weight: 4,  points: (12, 13),
         look: (colour: "00ff00", glow: 1.5, size: 1.35,
                shape: [(solid: Prism(3, 0.2, 0.12)),
                        (solid: Ball(0.12), at: (0.2, 0.0, 0.0)),
                        (solid: Ball(0.12), at: (-0.1, 0.0, 0.173)),
                        (solid: Ball(0.12), at: (-0.1, 0.0, -0.173))],
                beam: Some((height: 7.0, width: 0.16, alpha: 0.45, rise_secs: 0.15)),
                response: (shake: 0.3, flash: 0.07),
                sound: "drop_set")),
    ],
    bases: [
        (slot: Head,   names: ["Halter", "Fly Veil"]),
        (slot: Body,   names: ["Blanket", "Barding"]),
        (slot: Saddle, names: ["Saddle", "Saddle Pad"]),
    ],
)
