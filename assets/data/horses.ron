// The starting party. `class` picks each horse's one ability until abilities
// are bought from a shared pool (#221); it is never shown to the player.
// `attack_interval` is the seconds between its ordinary hits (#354), each a
// little longer or shorter by `attack_jitter` in rules.ron; until a speed
// stat sets it (#355) it is a number per horse. Kept apart, so the party
// does not hit in step.
[
    (name: "Juniper", class: Ranger, attack_interval: 1.4,  stats: (health: 40, attack: 6, defense: 1, elemental: 1)),
    (name: "Morrow",  class: Wizard, attack_interval: 1.6,  stats: (health: 30, attack: 3, defense: 0, elemental: 5)),
    (name: "Sable",   class: Mage,   attack_interval: 1.55, stats: (health: 35, attack: 3, defense: 1, elemental: 2)),
]
