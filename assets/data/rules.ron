// Combat and expedition rules. Times are in seconds.
(
    strong_multiplier: 1.5,
    weak_multiplier: 0.75,

    // Speed (#355). A horse's ordinary hits come `attack_tempo / speed`
    // seconds apart, its speed in horses.ron plus its gear's. The road
    // between two encounters, and back to town, takes
    // `travel_distance / speed` at the party's average speed (vision.md,
    // Gaits): 3.9 s for the starting party.
    attack_tempo: 31.0,
    travel_distance: 80.0,

    // Each swing comes up to this fraction sooner or later, seeded, so a
    // long fight does not fall into a fixed pattern (#354).
    attack_jitter: 0.1,
    // A fight opens with the horses' first hits one after another, in an
    // order rolled for the fight: the first at `opening`, the next
    // `opening_stagger` later, and so on.
    opening: 0.8,
    opening_stagger: 0.35,
    // The trail's final enemy comes up the trail for this long before its
    // fight's first blow, named and with its own bar (#19): the
    // anticipation beat (docs/philosophy/loot-fountain.md). Nothing is
    // struck or cast meanwhile.
    final_approach: 1.6,

    // The abilities' numbers are in abilities.ron (#357).

    ordinary_encounters: 3,

    // A fairy spring that heals the party after one encounter.
    bonus_chance: 0.25,
    bonus_heal: 0.3,

    // Enemy health and attack grow by this fraction per trail level.
    level_scaling: 0.15,

    // How many trails' reports the Journal keeps, the newest of them.
    reports_kept: 20,
)
