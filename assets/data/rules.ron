// Combat and expedition rules. Times are in seconds.
(
    strong_multiplier: 1.5,
    weak_multiplier: 0.75,

    // Each horse hits at its own `attack_interval` (horses.ron, #354). Each
    // swing comes up to this fraction sooner or later, seeded, so a long
    // fight does not fall into a fixed pattern.
    attack_jitter: 0.1,
    // A fight opens with the horses' first hits one after another, in an
    // order rolled for the fight: the first at `opening`, the next
    // `opening_stagger` later, and so on.
    opening: 0.8,
    opening_stagger: 0.35,

    // Ranger: bonus hit on the current target.
    focused_shot_cooldown: 4.0,
    focused_shot_multiplier: 2.5,

    // Wizard: elemental damage to every enemy.
    burst_cooldown: 5.0,
    burst_multiplier: 2.0,

    // Mage: the party takes less damage for a while.
    ward_cooldown: 8.0,
    ward_duration: 4.0,
    ward_reduction: 0.5,

    travel_secs: 4.0,
    ordinary_encounters: 3,

    // A fairy spring that heals the party after one encounter.
    bonus_chance: 0.25,
    bonus_heal: 0.3,

    // Enemy health and attack grow by this fraction per trail level.
    level_scaling: 0.15,

    // How many trails' reports the Journal keeps, the newest of them.
    reports_kept: 20,
)
