// The loot shower: every feel number of a drop leaving a body, flying, landing
// and coming to rest. Change one value at a time and look at it
// (procedures/tune-loot-feel.txt); F3 or --burst throws the same test burst
// every time. Lengths are world units (a horse is about 2 long), times are
// seconds, speeds are units a second. A pair is (least, most), rolled per piece.
(
    // Fountains: how a kill throws its drops, one for each kind of kill. An
    // enemy names its own in enemies.ron, so a new kind of kill is one more
    // entry here and its name there. The big one is kept for a trail's last
    // enemy (docs/philosophy/loot-fountain.md, Scarcity and restraint).
    //   delay_secs    from the death to the first piece leaving
    //   stagger_secs  pieces leave one after another, this far apart
    //   fan_degrees   in a fan this wide, which opens towards the party
    //   up_speed, out_speed   the arc: how fast up, and along the ground
    //   spin          tumbling in the air, in turns a second
    //   most_pieces   one coin piece per coin dropped, up to this many
    fountains: {
        // An ordinary enemy: small, quick, low.
        "small": (
            delay_secs: 0.0,
            stagger_secs: 0.02,
            fan_degrees: 140,
            up_speed: (6.0, 7.5),
            out_speed: (0.6, 1.4),
            spin: (1.5, 3.0),
            most_pieces: 6,
        ),
        // A trail's last enemy: a beat of nothing, then large, staggered, wide.
        "full": (
            delay_secs: 0.3,
            stagger_secs: 0.045,
            fan_degrees: 220,
            up_speed: (8.5, 11.5),
            out_speed: (0.9, 2.4),
            spin: (1.5, 3.0),
            most_pieces: 24,
        ),
    },

    gravity: 30.0,

    // Landing. A piece bounces this many times and rests on the next touch.
    // Each bounce keeps `bounce` of its upward speed and `grip` of its speed
    // along the ground and of its spin.
    bounces: 2,
    bounce: 0.42,
    grip: 0.55,
    // How far a landing flattens a piece (0 none, 1 flat), and for how long.
    squash: 0.4,
    squash_secs: 0.16,
    // Time to lie down flat once it has stopped.
    settle_secs: 0.2,

    // The pieces.
    coin_radius: 0.17,
    coin_thickness: 0.07,
    coin_colour: "e8c04a",
    // A piece of gear is a box this long, thick and deep, times its rarity's
    // `size`. Its colour, glow and beam are its rarity's, in gear.ron.
    gear_size: (0.46, 0.2, 0.34),
    // No piece comes to rest this close to an enemy still standing.
    keep_clear: 1.0,

    // Pickup. Once the whole burst is at rest it lies there this long, to be
    // read; then its pieces leave for the party this far apart, the nearest
    // first. A piece sets off at `pickup_speed`, gains `pickup_accel` every
    // second, and shrinks over the last `pickup_shrink` of the way.
    pickup_pause_secs: 0.9,
    pickup_stagger_secs: 0.06,
    pickup_speed: 1.0,
    pickup_accel: 45.0,
    pickup_shrink: 1.2,

    // Screen response. When a burst erupts (its first piece leaves) the scene
    // shakes and flashes once, as strongly as the best piece in it says and
    // no more for there being many: each rarity has its `response` in
    // gear.ron, and `coins` here is a burst with no gear in it. The flash is
    // the colour of that best piece and covers the scene, not the menus.
    //   shake_scale, flash_scale   multiply every shake and every flash;
    //                              0 turns that one off
    //   shake_secs, flash_secs     how long each takes to die away
    //   shake_hz                   how fast the view is thrown to and fro
    response: (
        shake_scale: 1.0,
        flash_scale: 1.0,
        shake_secs: 0.35,
        shake_hz: 16.0,
        flash_secs: 0.3,
        coins: (shake: 0.0, flash: 0.0),
    ),

    // The test burst: thrown as this fountain, with this many coins.
    burst_fountain: "full",
    burst_pieces: 40,
    // Gear thrown with them, by rarity name: a mixed burst to tell them apart in.
    burst_gear: ["Normal", "Normal", "Normal", "Magic", "Magic", "Rare", "Legendary", "Set"],
    burst_seed: 4,
)
