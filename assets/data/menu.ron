// Menu tokens: every size, colour and time the menu parts draw with. Change a
// value here and every screen changes; no menu code holds a number of its own.
// Sizes are logical pixels, times are seconds, colours are sRGB hex by role.
(
    space: (xs: 2, s: 4, m: 8, l: 16),

    text: (small: 11, body: 14, title: 18),

    size: (
        control_height: 30,
        row_height: 26,
        border: 1,
        radius: 3,
        // The bar that marks what is selected: shape, not only colour.
        mark: 3,
        focus_ring: 2,
        focus_gap: 2,
        card_width: 164,
        // A slot in the gear overview: room for a piece's name and one line
        // under it. A piece that adds to many stats takes a second line; at
        // 62, room for two always, the three slots no longer fit under the
        // scene at the smallest window.
        cell_height: 46,
        // A tile of the Inventory's grid: its width, and the side of the
        // picture on it. The grid has as many columns of that width as fit.
        // Wide enough for "Carried" and a horse's name on one line.
        inventory_cell: 104,
        inventory_picture: 56,
        // The comparison of a piece, pinned in a side panel or under the
        // pointer, in every place (#312): wide enough for its table of four
        // columns. Beside the Inventory's grid it keeps its room whether or
        // not a piece is open, so the grid never moves.
        compare_width: 420,
        // The stand-in picture of a piece of gear: the side of its square
        // and the room left around the shape in it. It sits under the
        // piece's name, beside the small lines, because the longest name
        // needs a slot's whole width at the smallest window; at 24 the
        // three slots still fit under the scene there. `picture_stamp` is
        // how much of the shape's narrower side the tier's mark takes.
        picture: 24,
        picture_inset: 2,
        picture_stamp: 0.8,
        side_panel_width: 280,
        confirm_width: 380,
        // Wide enough for the largest number shown, so a growing count never
        // moves what is beside it.
        counter_width: 96,
        // The bar beside a page that scrolls. Its width is kept when it is
        // hidden, so a page does not move when it starts to scroll.
        scrollbar_width: 6,
        // How much of what is in view a press of a scroll key moves by:
        // less than all of it, so the last line read is still there.
        scroll_page: 0.8,
        // The shell: a horse in the status strip, and the two columns that
        // stay beside the tabs of the Horses place.
        strip_horse_width: 150,
        // The detail opens in the cargo's room (#287), wide enough for a
        // horse's table of 25 letters (#311).
        cargo_width: 248,
        // The trail tracker in the footer: the side of one fight's mark, and
        // of the boss's, which is also turned to stand on a corner.
        trail_mark: 14,
        trail_boss: 16,
        // The dot in the corner of a place or tab that has something not
        // yet seen.
        attention: 9,
        // The fight log over the road scene (#306), at its top left, above
        // the party and clear of where an enemy falls: its width, how many
        // of the latest lines it shows, and how faint the oldest of them is
        // (the newest is 1).
        fight_log_width: 440,
        fight_log_lines: 6,
        fight_log_fade: 0.3,
        // The list of things to try (#303), over the town scene at its top
        // right, clear of the gate and the horses at the smallest window:
        // its width, which has room for an entry of 32 letters beside what
        // it pays, and the width of that last column.
        to_try_width: 390,
        to_try_pays: 64,
        // The hint (#291). Its line under the status strip keeps this
        // height whether or not a hint shows, so nothing moves when one
        // comes or goes: 22 is what is left under the road's scene at the
        // smallest window. `hint_control` is the height of the two controls
        // on it, and `pointer` the side of the square, stood on a corner,
        // that marks the control a hint is about.
        hint_height: 22,
        hint_control: 20,
        pointer: 6,
        // A lesson's pop-up (#353), beside the control it is about and never
        // over it: its width, which holds a line of 85 letters on two lines;
        // its edge, thicker than any control's, so it is told from the
        // menus with the colour taken away; the side of the square, stood
        // on a corner, that points from it to its control; how far it is
        // from that control; and how far it rises as it comes up.
        popup_width: 340,
        popup_border: 3,
        popup_arrow: 14,
        popup_gap: 10,
        popup_rise: 14,
    ),

    // The split of the window between the 3D scene, at the top, and the
    // menus. Shares are of the window's height. In town, and on the road
    // with a place open, the scene has town_share; on the road with every
    // place closed it has road_share. The window cannot be made smaller than
    // the minimum, which is the smallest size the bar, the status strip and
    // the footer still fit under the road's scene.
    layout: (
        town_share: 0.3333,
        road_share: 0.8,
        min_width: 1120,
        min_height: 640,
    ),

    // hover: how long a control takes to settle after the pointer arrives or
    // leaves. A press is never eased: it shows on the frame it happens.
    // hover_card: how long the pointer rests on a piece before its card
    // shows, so that a pointer on its way somewhere else raises nothing.
    // Once a card is up, the next piece's card shows at once.
    // layout: how long the scene takes to move between its two sizes.
    // popup: how long a lesson's pop-up takes to come up (#353): a movement
    // the eye catches, and short, so nothing waits on it.
    time: (hover: 0.08, hover_card: 0.25, layout: 0.45, popup: 0.22),

    colour: (
        screen: "14171a",
        panel: "1e2327",
        panel_border: "3a424a",

        control: "2a3138",
        control_border: "56616c",
        // Hover: "this can be done". A lighter fill, nothing else.
        hover: "46525e",
        hover_border: "aab6c2",
        // Pressed: the control inverts.
        pressed: "e6e9ec",
        pressed_text: "14171a",
        // Selected: "this is chosen". A sunk fill, an accent border and the
        // mark bar; never the hover fill.
        selected: "101214",
        accent: "f2c14e",
        unavailable_border: "2e353b",
        unavailable_text: "66707a",
        focus: "ffffff",

        text: "e6e9ec",
        text_dim: "9aa7b4",
        reason: "d9b96e",
        // Attention: "something here has not been seen". A round dot, where
        // the accent's mark is a bar. A hint's mark has this colour too,
        // and is a square stood on a corner (#291).
        attention: "5cc8ff",
        scrim: "000000b0",

        // What an item says, by kind (#251): the same colour means the same
        // thing on every screen. An element's colour is also the colour of
        // an enemy of that element in a fight. A trait's colour is the
        // colour of every line about that stat. They keep clear of each
        // other and of the rarity colours in gear.ron (white, blue, yellow,
        // orange, green), and a coloured line always keeps its word.
        element: (fire: "e64026", ice: "59a6f2", plant: "4dbf4d"),
        stat: (health: "ff8fb0", attack: "b99cff", defense: "45d0c0", elemental: "e56fdc"),
        // Whether a change is good (#313): on the change of a comparison,
        // never on an amount. A change always keeps its
        // sign and its word. They keep clear of every colour above and of
        // the rarities, stand 4.5 to 1 off the screen, a panel and a
        // control, and differ from each other in grey.
        change: (gain: "8cffaf", loss: "cd8778"),
    ),
)
