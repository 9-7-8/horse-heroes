// The lessons, in order (#290). Reorder, reword, add or remove one here; no
// code holds a lesson of its own. When several are waiting, the one nearest
// the top is shown first, and one is shown at a time.
//
// A lesson is something the player watches happen or does on the real
// control, with one line beside it: never a page to read (the owner,
// 2026-10-11). It never holds the party up and never makes a control
// unavailable.
//
//   id       its name: how it is known once put away, and to the Journal
//            later (#300). No two the same.
//   due      what has to happen first. It counts the first time it happens
//            and never again, so a return to town does not replay a lesson.
//              Fight     an encounter began
//              Ability   a horse's ability fired
//              Kill      an enemy went down
//              Resisted  a hit was resisted by its enemy's element
//              Win       a trail was won
//              Gear      the party came back to town with a piece
//              Card      the player opened a piece's card
//              Equipped  the player put a piece on a horse
//   shown    where: Town, Road, or left out for either. A Town lesson that
//            is showing when the party sets out waits for the next town.
//   target   the control its mark is on, named as places.ron names it:
//              Place("Journal")        a place in the bar, or Settings
//              Tab("Horses", "Gear")   a tab of a place
//              Control("Equip")        a control, wherever it is drawn
//              Horse(0)                a horse of the party, counted from 0
//              Drop                    the newest piece a trail brought back
//                                      that the party still has, where it is
//                                      now: in the cargo, or on a horse
//            A lesson whose target is not there waits until it is.
//   words    its one line, said after the target's name and key. Short: at
//            the smallest window the line has room for about a hundred
//            letters, the name included, and a piece's name is long.
//   done     what finishes it:
//              Watched(Kill)  that happens while the lesson is showing
//              Did(Equipped)  that happens once the lesson is due, shown or
//                             not: the player needed no telling
//   instead  the line to say when the state has moved on: when a Drop is
//            no longer in the cargo but on a horse.
//
// These four are a starting set, from docs/philosophy/onboarding.md. The
// first trail's lessons are #295, the first item's #296, the element's #299.
#![enable(implicit_some)]
[
    (
        id: "the party fights by itself",
        due: Fight,
        shown: Road,
        target: Horse(0),
        words: "The horses fight by themselves. Nothing here needs a press; watch this fight.",
        done: Watched(Kill),
    ),
    (
        id: "abilities fire by themselves",
        due: Ability,
        shown: Road,
        target: Horse(2),
        words: "Each horse has one ability, and uses it by itself when it is ready.",
        done: Watched(Ability),
    ),
    (
        id: "read the piece",
        due: Gear,
        shown: Town,
        target: Drop,
        words: "Press it to read it against what the selected horse wears.",
        done: Did(Card),
        instead: "It went on at the gate, on the horse it helps most. Press it to read it.",
    ),
    (
        id: "equip or leave it",
        due: Card,
        shown: Town,
        target: Control("Equip"),
        words: "Puts the open piece on the selected horse. Left alone, it goes where it helps most.",
        done: Did(Equipped),
    ),
]
